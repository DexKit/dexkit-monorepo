{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "ES2021.String"
    ],
    "skipDefaultLibCheck": true,
    "types": [],
    "noLib": false,
    "strictNullChecks": false,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "Bundler",
    "downlevelIteration": true,
    "jsx": "preserve",
    "jsxImportSource": "@emotion/react",
    "incremental": true,
    "typeRoots": [
      "../../node_modules/@0x/typescript-typings/types",
      "../../node_modules/@types"
    ],
    "baseUrl": ".",
    "paths": {
      "@/modules/*": [
        "src/modules/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "global.d.ts",
    "middleware.ts",
    "next-seo.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "pages/**/*.ts",
    "pages/**/*.tsx",
    "next-sitemap.config.js",
    "scripts/local-diff.js",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".next/cache",
    ".turbo",
    "coverage",
    "**/*.test.ts",
    "**/*.test.tsx",
    "__tests__/**"
  ]
}
