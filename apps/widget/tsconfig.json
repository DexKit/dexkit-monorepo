{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext", "ES2021.String"],
    "noImplicitAny": false,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "Bundler",
    "downlevelIteration": true,
    "jsx": "preserve",
    "jsxImportSource": "@emotion/react",
    "incremental": true,
    "typeRoots": [
      "../../node_modules/@0x/typescript-typings/types",
      "../../node_modules/@types"
    ],
    "baseUrl": ".",
    "paths": {
      "@/modules/*": ["src/modules/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": []
  },
  "include": [
    "next-env.d.ts",
    "pages/**/*.ts",
    "pages/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "next-sitemap.config.js",
    "scripts/local-diff.js",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".next/cache",
    ".turbo",
    "coverage",
    "**/*.test.ts",
    "**/*.test.tsx",
    "__tests__/**"
  ]
}
