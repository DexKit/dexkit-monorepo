{
  "extends": "tsconfig/react-library.json",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".turbo",
    "coverage",
    "storybook-static",
    "stories",
    ".storybook",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "moduleResolution": "Bundler",
    "typeRoots": [
      "../../node_modules/@0x/typescript-typings/types",
      "../../node_modules/@types"
    ]
  }
}
