{
  "extends": "tsconfig/react-library.json",
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "resolveJsonModule": true,
    "moduleResolution": "Bundler",
    "target": "es2020",
    "lib": ["es2021"]
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".turbo",
    "coverage",
    "storybook-static",
    "stories",
    ".storybook",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
