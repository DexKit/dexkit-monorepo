{
  "extends": "tsconfig/react-library.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "tsup.config.ts"],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist/",
    "lib": ["ES5", "ES6", "ESNext", "ES2016", "DOM", "es2017"],
    "target": "ES6"
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".turbo",
    "coverage",
    "storybook-static",
    "stories",
    ".storybook"
  ]
}
